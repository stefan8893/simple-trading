{
  "BaseUrl": "https://simple-trading-web-api.azurewebsites.net/",
  "DbProvider": "SqlServer",
  "ConnectionStrings": {
    "SqlServer": "<secret>",
    "Postgres": "<secret>",
    "Sqlite": "<secret>"
  },
  "CorsUrls": {
    "ClientApp": [
      "https://simpletrading.z6.web.core.windows.net",
      "https://localhost:5173",
      "http://localhost:5173",
      "http://localhost:4173"
    ]
  },
  "Auth": {
    "SimpleTradingWebApi": {
      "Instance": "https://login.microsoftonline.com/",
      "Domain": "<secret>",
      "TenantId": "<secret>",
      "ClientId": "<secret>",
      "Audience": "<secret>"
    },
    "SimpleTradingClientApp": {
      "AuthorizationUrl": "https://login.microsoftonline.com/f64914bc-6b63-492c-9d53-830b704506e2/oauth2/v2.0/authorize",
      "TokenUrl": "https://login.microsoftonline.com/f64914bc-6b63-492c-9d53-830b704506e2/oauth2/v2.0/token",
      "ClientId": "25b4f7f2-9c21-4571-800c-5a92c0dd826a",
      "Scopes": [
        {
          "value": "api://simple-trading-web-api/access_as_user",
          "description": "Gives access to SimpleTrading.WebApi (backend)."
        }
      ]
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Mvc": "Warning",
        "Microsoft.AspNetCore.Routing": "Warning",
        "Microsoft.AspNetCore.Hosting": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "SimpleTrading"
    }
  }
}
