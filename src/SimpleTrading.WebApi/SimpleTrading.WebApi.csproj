<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <UserSecretsId>SimpleTrading.WebApi</UserSecretsId>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <ApiDescriptionFileName>simple-trading-api-description</ApiDescriptionFileName>
        <OpenApiGenerateDocumentsOptions>--file-name $(ApiDescriptionFileName)</OpenApiGenerateDocumentsOptions>
        <NoWarn>$(NoWarn);1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.7"/>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.7"/>
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="9.0.7">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Scalar.AspNetCore" Version="2.6.8"/>
        <PackageReference Include="Microsoft.Identity.Web" Version="3.12.0"/>
        <PackageReference Include="NSwag.CodeGeneration.CSharp" Version="14.5.0"/>
        <PackageReference Include="NSwag.CodeGeneration.TypeScript" Version="14.5.0"/>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.7">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Autofac" Version="8.3.0"/>
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="10.0.0"/>
        <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1"/>
        <PackageReference Include="Serilog.AspNetCore" Version="9.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SimpleTrading.DataAccess.Postgres\SimpleTrading.DataAccess.Postgres.csproj"/>
        <ProjectReference Include="..\SimpleTrading.DataAccess.Sqlite\SimpleTrading.DataAccess.Sqlite.csproj"/>
        <ProjectReference Include="..\SimpleTrading.DataAccess.SqlServer\SimpleTrading.DataAccess.SqlServer.csproj"/>
        <ProjectReference Include="..\SimpleTrading.Domain\SimpleTrading.Domain.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Clients\Generated\SimpleTrading.Client.ts"/>
    </ItemGroup>

    <ItemGroup>
      <Folder Include="wwwroot\" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="Clients\Generated\SimpleTrading.Client.cs" />
      <None Include="Clients\Generated\SimpleTrading.Client.cs" />
    </ItemGroup>

    <Target Name="CopyApiDescriptionFile" AfterTargets="Build">
        <PropertyGroup>
            <GeneratedApiDescriptionPath>$(BaseIntermediateOutputPath)$(ApiDescriptionFileName).json</GeneratedApiDescriptionPath>
        </PropertyGroup>

        <Message Importance="High" Text="Checking if '$(GeneratedApiDescriptionPath)' exists..."/>

        <ItemGroup Condition="Exists('$(GeneratedApiDescriptionPath)')">
            <GeneratedApiDescription Include="$(GeneratedApiDescriptionPath)"/>
        </ItemGroup>

        <Copy
                Condition="@(GeneratedApiDescription->Count()) != 0" 
                SourceFiles="@(GeneratedApiDescription)" 
                DestinationFolder="$(OutputPath)" 
                SkipUnchangedFiles="true"/>

        <Message Condition="@(GeneratedApiDescription->Count()) != 0"
                 Importance="High"
                 Text="Api Description successfully copied to $(OutputPath)."/>

        <Message Condition="@(GeneratedApiDescription->Count()) == 0"
                 Importance="High"
                 Text="No Api Description found. Copy Task skipped."/>
    </Target>
</Project>
