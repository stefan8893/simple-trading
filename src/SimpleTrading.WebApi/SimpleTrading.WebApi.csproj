<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <UserSecretsId>SimpleTrading.WebApi</UserSecretsId>
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <ApiDescriptionFileName>simple-trading-api-description</ApiDescriptionFileName>
        <OpenApiGenerateDocumentsOptions>--file-name $(ApiDescriptionFileName)</OpenApiGenerateDocumentsOptions>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.9" />
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.9">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Scalar.AspNetCore" Version="2.16.2" />
        <PackageReference Include="Microsoft.Identity.Web" Version="4.10.0" />
        <PackageReference Include="NSwag.CodeGeneration.CSharp" Version="14.7.1" />
        <PackageReference Include="NSwag.CodeGeneration.TypeScript" Version="14.7.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Autofac" Version="9.1.0"/>
        <PackageReference Include="Autofac.Extensions.DependencyInjection" Version="11.0.0"/>
        <PackageReference Include="System.CommandLine" Version="2.0.9" />
        <PackageReference Include="Serilog.AspNetCore" Version="10.0.0"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SimpleTrading.DataAccess.Postgres\SimpleTrading.DataAccess.Postgres.csproj"/>
        <ProjectReference Include="..\SimpleTrading.DataAccess.Sqlite\SimpleTrading.DataAccess.Sqlite.csproj"/>
        <ProjectReference Include="..\SimpleTrading.DataAccess.SqlServer\SimpleTrading.DataAccess.SqlServer.csproj"/>
        <ProjectReference Include="..\SimpleTrading.Domain\SimpleTrading.Domain.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Clients\Generated\SimpleTrading.Client.ts"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Clients\Npm\simple-trading-client\dist\lib\"/>
        <Folder Include="wwwroot\"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Clients\Generated\SimpleTrading.Client.cs"/>
        <None Include="Clients\Generated\SimpleTrading.Client.cs"/>
    </ItemGroup>

    <Target Name="CopyApiDescriptionFile" AfterTargets="Build">
        <PropertyGroup>
            <GeneratedApiDescriptionPath>$(BaseIntermediateOutputPath)$(ApiDescriptionFileName).json</GeneratedApiDescriptionPath>
        </PropertyGroup>

        <Copy
                Condition="Exists('$(GeneratedApiDescriptionPath)')"
                SourceFiles="$(GeneratedApiDescriptionPath)"
                DestinationFolder="$(OutputPath)"
                SkipUnchangedFiles="true"/>

        <Message Condition="Exists('$(GeneratedApiDescriptionPath)')"
                 Importance="High"
                 Text="Copying API description $(GeneratedApiDescriptionPath) to $(OutputPath)."/>

        <Message Condition="!Exists('$(GeneratedApiDescriptionPath)')"
                 Importance="High"
                 Text="No API description found."/>
    </Target>
</Project>